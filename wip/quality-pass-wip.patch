+    n = (pts[1] - pts[0]).cross(pts[2] - pts[0])
+    if n.length < 1e-12:
+        return [(p.x, p.z) for p in pts]
+    n.normalize()
+    ex = (pts[1] - pts[0])
+    if ex.length < 1e-9:
+        ex = Vector((1, 0, 0))
+    ex = (ex - n * ex.dot(n)).normalized()
+    ey = n.cross(ex)
+    return [((p - pts[0]).dot(ex), (p - pts[0]).dot(ey)) for p in pts]
