// Minimal stand-in for the Guidelines Support Library <gsl/pointers> (syntax checking only).
#pragma once
#include <type_traits>
#include <utility>
namespace gsl {
template <class T> class not_null {
public:
	template <class U, class = std::enable_if_t<std::is_convertible<U, T>::value>> constexpr not_null(U&& u) : ptr_(std::forward<U>(u)) {}
	template <class U, class = std::enable_if_t<std::is_convertible<U, T>::value>> constexpr not_null(const not_null<U>& other) : ptr_(other.get()) {}
	constexpr T get() const { return ptr_; }
	constexpr operator T() const { return get(); }
	constexpr decltype(auto) operator->() const { return get(); }
	constexpr decltype(auto) operator*() const { return *get(); }
private:
	T ptr_;
};
template <class T> auto make_not_null(T&& t) { return not_null<std::remove_cv_t<std::remove_reference_t<T>>>{std::forward<T>(t)}; }
}
