// Fourfold FX - ground effects (stream `fx`):
//   M_FX_GroundStrip (opaque Default Lit) - ground-hugging path strips (Style 0 sand surge, 1 rime / ice sheet, 2 mud)
//   M_FX_Ground (translucent Default Lit, a lifted quad instead of a deferred decal) - zone decals: Style
//     0 quicksand swirl  1 ice floor  2 mud  3 melt pit  4 static field  5 caltrop shade  6 frost patch  7 sand drift
//     8 wet mark (puddles, splashes)
// Port + upgrade of game/presentation/vfx/shaders/strip_ground.gdshader and ground_fx.gdshader.
// Strip contract (AppendPathStrip): uv0 = (metres along, metres across), uv2 = (metres to the front, height fraction
// 0 edge .. 1 crest). Decal contract (GroundQuad): uv0 0..1 across the zone. Portability rules: FFCommon.ush.
#ifndef FF_GROUND_USH
#define FF_GROUND_USH

#ifndef FF_COMMON_USH
#include "/Fourfold/Common/FFCommon.ush"
#endif
#ifndef FF_NOISE_USH
#include "/Fourfold/Common/FFNoise.ush"
#endif

// ------------------------------------------------------------------------------------------------ M_FX_GroundStrip
// n1 / n2 = noise at (uv along - Flow, across) x 0.6 and x 2.9 (node code). Tangent-space normal.
FFSurf FFGroundStripSurface(float2 uv0, float2 uv2, float4 n1, float4 n2, float style, float flow, float crust)
{
	FFSurf s = FFSurfDefault(float3(0.0, 0.0, 1.0));
	const float crest = uv2.y;
	const float ux = uv0.x - flow;
	float3 col;
	if (style < 0.5)
	{
		// sand surge: granular ochre, ripples travelling with the flow, pale dusty crest
		const float rip = sin(ux * 9.0 + n1.x * 4.0) * 0.5 + 0.5;
		const float grain = n2.x * 0.6 + n2.y * 0.4;
		col = lerp(float3(0.13, 0.085, 0.045), float3(0.34, 0.24, 0.13), FFSmooth(0.2, 0.9, crest * 0.7 + grain * 0.4));
		col = col * (0.7 + 0.45 * rip * (1.0 - crust * 0.6));
		col = lerp(col, float3(0.45, 0.36, 0.22), FFSmooth(0.88, 1.0, crest) * 0.45 * (1.0 - crust));
		s.rough = 0.95;
		s.spec = 0.2;
		const float dr = cos(ux * 9.0 + n1.x * 4.0) * 0.25;
		s.normal = normalize(float3(-dr, (grain - 0.5) * 0.3, 1.0));
	}
	else if (style < 1.5)
	{
		// rime / ice sheet: pale frosted ice, crystal cells, glossy
		float2 g = float2(0.0, 0.0);
		const float4 vr = FFVoronoi2(float2(ux * 2.2, uv0.y * 2.2), g);
		const float cell = FFSmooth(0.0, 0.05, vr.y);
		const float fr = FFSmooth(0.35, 0.9, n1.x * 0.7 + n2.z * 0.5);
		col = lerp(float3(0.20, 0.36, 0.46), float3(0.55, 0.68, 0.76), saturate(fr * 0.8 + crest * 0.3));
		col = lerp(col * 1.15, col, cell);
		s.rough = lerp(0.12, 0.6, fr);
		s.spec = 0.75;
		s.emissive = float3(0.10, 0.18, 0.24) * ((1.0 - cell) * 0.6);
		s.normal = normalize(float3(-g.x * 0.08 * (1.0 - cell), -g.y * 0.08 * (1.0 - cell), 1.0));
	}
	else
	{
		// mud: dark wet earth with glossy puddles
		const float wet = FFSmooth(0.45, 0.7, n1.x);
		col = lerp(float3(0.10, 0.075, 0.05), float3(0.20, 0.15, 0.10), n2.x);
		col = col * (1.0 - 0.45 * wet);
		s.rough = lerp(0.75, 0.12, wet);
		s.spec = lerp(0.3, 0.8, wet);
		s.normal = normalize(float3((n2.y - 0.5) * 0.4 * (1.0 - wet), (n2.z - 0.5) * 0.4 * (1.0 - wet), 1.0));
	}
	const float tail = FFSmooth(0.0, 0.2, crest);
	s.albedo = col * (0.75 + 0.25 * tail);
	return s;
}

// ------------------------------------------------------------------------------------------------ M_FX_Ground
// Lit translucent decal. n / n2 = noise at uv x 1.4 + seed and x 2.6 (node code), crackle = noise sample for the
// static-field lines at a stepped phase (node code). Returns the surface; opacity in s.opacity.
FFSurf FFGroundDecalSurface(float2 uv, float4 n, float4 n2, float4 crackle, float style, float phase, float heat,
	float seed, float fade)
{
	FFSurf s = FFSurfDefault(float3(0.0, 0.0, 1.0));
	const float2 p = float2(uv.x * 2.0 - 1.0, uv.y * 2.0 - 1.0);
	const float r = length(p);
	const float ang = atan2(p.y, p.x);
	const float ragged = (n.x - 0.5) * 0.3 + (n2.x - 0.5) * 0.08;
	const float body = 1.0 - FFSmooth(0.72, 0.98, r + ragged);
	float3 col = float3(0.5, 0.5, 0.5);
	float a = body;
	s.rough = 0.9;
	s.spec = 0.3;
	if (style < 0.5)
	{
		// quicksand: a slow sinking swirl
		const float sw = sin(ang * 3.0 + r * 14.0 - phase * 2.5 + n.x * 2.0) * 0.5 + 0.5;
		col = lerp(float3(0.30, 0.22, 0.12), float3(0.55, 0.43, 0.27), sw * (0.6 + 0.4 * n2.x));
		col = col * (0.55 + 0.45 * FFSmooth(0.0, 0.6, r));
		s.rough = 0.92;
		s.normal = normalize(float3(cos(ang * 3.0 + r * 14.0 - phase * 2.5) * 0.25, 0.0, 1.0));
		a = body * 0.95;
	}
	else if (style < 1.5)
	{
		// ice floor: glossy blue-white sheet with crack lines
		float2 g = float2(0.0, 0.0);
		const float4 vr = FFVoronoi2(float2(uv.x * 6.0 + seed, uv.y * 6.0 + seed), g);
		const float crack = 1.0 - FFSmooth(0.0, 0.04, vr.y);
		col = lerp(float3(0.30, 0.48, 0.58), float3(0.55, 0.72, 0.80), n.x);
		col = lerp(col, float3(0.85, 0.93, 0.98), crack * 0.6);
		s.rough = lerp(0.06, 0.3, n2.z);
		s.spec = 0.85;
		a = body * (0.55 + 0.2 * n.y);
	}
	else if (style < 2.5)
	{
		// mud
		const float wet = FFSmooth(0.4, 0.7, n.x);
		col = lerp(float3(0.12, 0.09, 0.06), float3(0.06, 0.045, 0.03), wet);
		s.rough = lerp(0.8, 0.1, wet);
		s.spec = lerp(0.3, 0.85, wet);
		a = body * 0.92;
	}
	else if (style < 3.5)
	{
		// melt pit: black glassy crust, glowing fissures, a hot rim
		float2 g = float2(0.0, 0.0);
		const float4 vr = FFVoronoi2(float2(uv.x * 5.0 + seed, uv.y * 5.0 + seed), g);
		const float fis = 1.0 - FFSmooth(0.0, 0.06 + 0.1 * heat, vr.y);
		const float rim = FFSmooth(0.55, 0.85, r) * (1.0 - FFSmooth(0.85, 1.0, r + ragged));
		const float flick = 0.9 + 0.1 * sin(phase * 3.0 + n.x * 9.0);
		col = float3(0.02, 0.017, 0.015);
		s.rough = 0.5;
		s.emissive = FFBlackbody(0.55 + 0.4 * heat * n2.x) * ((fis * (1.0 - r * 0.5) + rim * 0.8) * 2.0 * heat * flick);
		a = body;
	}
	else if (style < 4.5)
	{
		// static field: violet-blue crawling lines
		const float c = 1.0 - abs(crackle.z * 2.0 - 1.0);
		const float lineK = pow(saturate(c), 18.0);
		col = float3(0.05, 0.06, 0.1);
		s.emissive = float3(0.55, 0.65, 1.0) * (lineK * 3.0);
		a = body * (0.25 + lineK);
	}
	else if (style < 5.5)
	{
		// shade under a caltrop field
		col = float3(0.03, 0.03, 0.035);
		a = body * 0.35;
	}
	else if (style < 6.5)
	{
		// frost / rime patch
		col = lerp(float3(0.75, 0.85, 0.9), float3(0.95, 0.98, 1.0), n2.x);
		s.rough = 0.5;
		a = body * FFSmooth(0.3, 0.6, n.x + 0.25) * 0.85;
	}
	else if (style < 7.5)
	{
		// sand drift
		col = lerp(float3(0.42, 0.33, 0.20), float3(0.62, 0.50, 0.33), n2.x);
		a = body * FFSmooth(0.35, 0.65, n.y + 0.2) * 0.7;
	}
	else
	{
		// wet mark: darkened, glossy ground
		col = float3(0.025, 0.028, 0.03);
		s.rough = 0.08;
		s.spec = 0.8;
		a = body * (0.55 + 0.2 * n.y);
	}
	s.albedo = col;
	s.opacity = saturate(a * fade);
	return s;
}

#endif  // FF_GROUND_USH
