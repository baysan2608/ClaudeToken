// Fourfold FX - living vines, roots and lattice (stream `fx`, M_FX_Vine, opaque Default Lit). Deep green skin with
// darker spiral grooves and thorn bumps, bark brown toward thick bases, a soft living rim, charring with Burn (black
// skin, ember cracks that glow while it still burns), rime with Frozen. Growth is done on the CPU (VineTubes).
// Port + upgrade of game/presentation/vfx/shaders/vine.gdshader.
// Mesh contract (AppendTube): uv0 = (around 0..1, metres along), uv1 = (along 0..1, tube random).
// Portability rules: FFCommon.ush.
#ifndef FF_VINE_USH
#define FF_VINE_USH

#ifndef FF_COMMON_USH
#include "/Fourfold/Common/FFCommon.ush"
#endif

// Local offset (cm): a slow sway that grows toward the tip; frozen vines stand still.
float3 FFVineOffset(float2 uv1, float phase, float frozen)
{
	const float s = uv1.x;
	const float sway = 3.0 * s * (1.0 - saturate(frozen));
	return float3(sin(phase * 1.3 + s * 6.0 + uv1.y * 9.0) * sway, cos(phase * 1.1 + s * 5.0 + uv1.y * 7.0) * sway, 0.0);
}

// Lit surface (tangent-space normal). n1 / n2 = noise samples (node code), ndv = saturate(dot(normal, view)).
FFSurf FFVineSurface(float2 uv0, float2 uv1, float4 n1, float4 n2, float ndv, float burn, float frozen)
{
	FFSurf s = FFSurfDefault(float3(0.0, 0.0, 1.0));
	const float3 green = float3(0.15, 0.40, 0.09);
	const float3 bark = float3(0.20, 0.13, 0.07);
	const float gw = sin((uv0.x * 6.0 + uv0.y * 2.2) * FF_PI) * 0.5 + 0.5;
	const float groove = FFSmooth(0.55, 0.9, gw);
	const float thorn = FFSmooth(0.82, 0.95, n2.x);
	float3 col = lerp(green * 1.35, green * 0.55, groove * 0.7);
	col = lerp(col, bark, FFSmooth(0.0, 0.6, 0.6 - uv1.x) * 0.55 + n1.x * 0.15);
	col = lerp(col, float3(0.35, 0.30, 0.12), thorn * 0.6);
	// burn: char spreads from the noise up; ember cracks while it is still burning
	const float charred = FFSmooth(0.0, 1.0, burn * 1.6 - n1.y * 0.6);
	col = lerp(col, float3(0.02, 0.018, 0.015), charred);
	const float3 emb = FFBlackbody(0.7) * (FFSmooth(0.75, 0.95, n2.y) * charred * (1.0 - FFSmooth(0.85, 1.0, burn)) * 2.0);
	col = lerp(col, float3(0.70, 0.84, 0.92), saturate(frozen) * 0.7);
	const float rim = pow(1.0 - saturate(ndv), 3.0);
	s.albedo = col;
	s.rough = lerp(lerp(0.55, 0.9, charred), 0.35, saturate(frozen) * 0.6);
	s.spec = 0.35 + 0.3 * saturate(frozen);
	s.emissive = emb + green * (rim * 0.35 * (1.0 - charred) * (1.0 - saturate(frozen)));
	// grooves and thorns as tangent-space relief (around = tangent X)
	const float dg = cos((uv0.x * 6.0 + uv0.y * 2.2) * FF_PI) * 0.35;
	s.normal = normalize(float3(-dg, -(thorn - 0.5) * 0.3, 1.0));
	return s;
}

#endif  // FF_VINE_USH
