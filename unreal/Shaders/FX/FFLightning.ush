// Fourfold FX - lightning, beams and sparks (stream `fx`; all unlit, additive or premultiplied, two-sided, no depth
// write). Port + upgrade of game/presentation/shaders/lightning.gdshader, spark.gdshader, vfx/shaders/beam.gdshader.
//   M_FX_Lightning (additive) bolts, arcs, crackle: camera-facing ribbons built on the CPU (FxLightning):
//       uv0 = (across 0..1, metres along), vertex colour = (1, branch life, 1, brightness variation)
//       Age 0..1 over the strike, Intensity, Color = halo colour (the core is near white)
//   M_FX_Beam (AlphaComposite) needles / beams / sandblast / water-jet cores / sound lances: the Beam strip
//       (uv0 = (side 0/1, along 0..1)) faces the camera from the CPU; Color = core, Color2 = glow, Width, Taper,
//       Grain (granular sand), Cover, Age, Scroll
//   M_FX_Spark (additive) motes, embers, glints, streaks: CPU particles, uv0 = quad corner, vertex colour = colour x
//       alpha over life, EmissiveScale
// Portability rules: FFCommon.ush.
#ifndef FF_LIGHTNING_USH
#define FF_LIGHTNING_USH

#ifndef FF_COMMON_USH
#include "/Fourfold/Common/FFCommon.ush"
#endif

// ------------------------------------------------------------------------------------------------ bolts
// Emissive (additive). duration = strike length in seconds (flicker is quantised to 60 Hz frames).
float3 FFBoltShade(float2 uv0, float4 vc, float age, float intensity, float3 halo, float duration)
{
	const float x = uv0.x * 2.0 - 1.0;
	const float core = exp(-x * x * 60.0);
	const float glow = exp(-x * x * 7.0) + exp(-x * x * 1.6) * 0.35;
	const float t = saturate(age);
	// strike flash, then a flicker with re-strikes, then fade
	const float stepT = floor(t * duration * 60.0);
	const float flick = lerp(0.35, 1.0, FFHash11(stepT * 1.31 + 3.0) > 0.45 ? 1.0 : 0.0);
	const float env = (1.0 - FFSmooth(0.55, 1.0, t)) * lerp(1.0, flick, FFSmooth(0.08, 0.3, t)) + 1.5 * (1.0 - FFSmooth(0.0, 0.12, t));
	// branches (life < 1) die earlier than the main bolt
	const float life = vc.y;
	const float lifeMask = life > 0.999 ? 1.0 : 1.0 - FFSmooth(0.25 + 0.5 * life, 0.4 + 0.6 * life, t);
	// brightness crackle along the bolt
	const float varB = 0.85 + 0.30 * sin(uv0.y * 9.0 + stepT * 2.3 + FFHash11(stepT) * 6.0) * vc.w;
	const float e = env * lifeMask * varB * intensity;
	const float3 coreCol = lerp(float3(1.0, 0.97, 1.0), halo, 0.12);
	// the glow is a saturated version of the tint (electric blue-violet from a pale palette colour)
	const float3 glowCol = lerp(halo, halo * halo * 1.3, 0.7);
	return (coreCol * (core * 3.4) + glowCol * (glow * 1.7)) * e;
}

// ------------------------------------------------------------------------------------------------ beams
// Local offset (cm) of a beam strip vertex: width tapers toward the tip and ripples. pos = local position (cm; X is
// across, Z along 0..100).
float3 FFBeamOffset(float3 pos, float2 uv0, float taper, float scroll)
{
	const float along = uv0.y;
	const float m = lerp(1.0, 1.0 - along * 0.85, taper) * (0.85 + 0.3 * sin(along * 30.0 - scroll * 20.0));
	return float3(pos.x * (m - 1.0), 0.0, 0.0);
}

// Premultiplied emissive (rgb) + opacity (a). n1 / n2 = noise at (along x 3 - scroll x 2, across) and the fine grain
// coordinates (node code).
float4 FFBeamShade(float2 uv0, float4 n1, float4 n2, float age, float intensity, float cover, float grain,
	float3 coreCol, float3 glowCol)
{
	const float across = uv0.x * 2.0 - 1.0;
	const float along = uv0.y;
	const float x = abs(across);
	const float core = exp(-x * x * 18.0);
	const float halo = exp(-x * x * 3.0) * (0.5 + 0.5 * n1.x);
	const float life = FFSmooth(0.0, 0.08, age) * (1.0 - FFSmooth(0.55, 1.0, age));
	const float ends = FFSmooth(0.0, 0.04, along) * (1.0 - FFSmooth(0.85, 1.0, along + (n1.x - 0.5) * 0.2));
	const float gr = lerp(1.0, FFSmooth(0.35, 0.75, n2.y), grain);
	const float k = (core * 1.2 + halo * 0.6) * life * ends * intensity * gr;
	const float3 c = lerp(glowCol, coreCol, core);
	return float4(c * (k * 1.6), saturate(k * cover));
}

// ------------------------------------------------------------------------------------------------ sparks
// Emissive (additive): HDR core + soft halo, round in quad space (streak quads stretch it along the velocity).
float3 FFSparkShade(float2 uv0, float4 vc, float emissiveScale)
{
	const float2 p = float2(uv0.x * 2.0 - 1.0, uv0.y * 2.0 - 1.0);
	const float d = dot(p, p);
	const float core = exp(-d * 9.0);
	const float halo = exp(-d * 2.2) * 0.22;
	return FFRGB(vc) * ((core + halo) * saturate(vc.w) * emissiveScale);
}

#endif  // FF_LIGHTNING_USH
